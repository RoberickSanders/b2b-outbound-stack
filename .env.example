# Copy to .env and fill in only what you use. Never commit .env.
# Every key is optional for `python doctor.py --fast` and the test suite.

# --- Core ---
SMARTLEAD_API_KEY=your-smartlead-key
ANTHROPIC_API_KEY=your-anthropic-key
KIMI_API_KEY=your-kimi-key            # light-task router; set FORGE_FORCE_CLAUDE=true to skip
FORGE_FORCE_CLAUDE=false

# --- Discovery ---
SERPER_API_KEY=your-serper-key
BLITZ_API_KEY=your-blitz-key
AIARK_API_KEY=your-aiark-key
RAPIDAPI_KEY=your-rapidapi-key

# --- Enrichment + verification ---
HUNTER_API_KEY=your-hunter-key
ICYPEAS_API_KEY=your-icypeas-key
ICYPEAS_API_SECRET=your-icypeas-secret
ICYPEAS_USER_ID=your-icypeas-user-id
MILLIONVERIFIER_API_KEY=your-millionverifier-key
BOUNCEBAN_API_KEY=your-bounceban-key

# --- Mailbox provisioning ---
INBOXKIT_API_KEY=your-inboxkit-key
PORKBUN_API_KEY=your-porkbun-key
PORKBUN_SECRET_KEY=your-porkbun-secret

# --- Alerts + reply drafts (optional) ---
PUSHOVER_USER_KEY=your-pushover-user
PUSHOVER_APP_TOKEN=your-pushover-app-token
TRELLO_API_KEY=your-trello-key
TRELLO_TOKEN=your-trello-token
TRELLO_LIST_ID_NEW=your-trello-list-id

# --- Run limits ---
FORGE_COST_LIMIT=25
FORGE_WORKERS=5
